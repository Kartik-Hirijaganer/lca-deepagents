# Copy to .env and fill in. Never commit .env.
#
# mda reads .env, uses LANGSMITH_API_KEY for LangSmith, and forwards your model
# provider key as a deployment secret.

LANGSMITH_API_KEY=
ANTHROPIC_API_KEY=

# Optional: target a specific workspace on deploy.
# LANGSMITH_WORKSPACE_ID=

# Only needed if you keep channels/slack.py. Both come from your own Slack app
# at api.slack.com/apps. Delete channels/slack.py to deploy without Slack.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
